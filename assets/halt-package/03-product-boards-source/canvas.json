,"Spec.dc.html","ThreadGraph.dc.html","AppRail.dc.html","AppTopbar.dc.html"],"notes":{"t1":{"x":0,"y":-300,"text":"HALT — Proof-Carrying Cyber Response","kind":"title1","maxW":1440},"t2":{"x":2000,"y":-300,"text":"HALT product — the response, end to end","kind":"title1","maxW":1440},"n1":{"x":1520,"y":0,"w":360,"text":"Palette and typefaces were not attached. Colour values are PROVISIONAL tokens (Ink, Bone, Ember, Verdigris) and the type is Archivo + IBM Plex Mono. The mark itself is single-colour and the wordmark is outlined geometry, so swapping in the approved system changes only token values.","fill":"orange"},"n2":{"x":3600,"y":-200,"w":420,"text":"Reusable components. ThreadGraph takes mode (observed, forecast, response, cut, isolate), focus (P1 to P6), scale, labels and motion. Every screen imports it.","fill":"teal"}},"designSystems":[]}
