# Copy to .env. All demo data is synthetic (SIMULATED).

# --- API (services/api) ---
# postgresql+psycopg://... (Docker) or sqlite+pysqlite:///./halt.db (no-Docker fallback)
HALT_DB_URL=postgresql+psycopg://halt:halt@localhost:5432/halt
HALT_SEED=2417
HALT_SIGNING_KEY_PATH=./secrets/demo-signing-key.pem
HALT_LLM_ENABLED=false
HALT_CORS_ORIGINS=http://localhost:3000
HALT_LOG_LEVEL=INFO

# --- Web (apps/web) ---
# Origins only: the typed client adds /api/v1/..., the socket adds /ws/incidents/{id}
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_WS_ORIGIN=ws://localhost:8000
NEXT_PUBLIC_DEMO_MODE=simulated
