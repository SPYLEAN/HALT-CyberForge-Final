# Copy to .env. All demo data is synthetic (SIMULATED).

# --- API (services/api) ---
# No real credentials belong here: the values below are local demo placeholders.
# `npm run dev` / `npm run demo` set HALT_DB_URL to a SQLite file under .halt/ unless you set it yourself.
# sqlite+pysqlite:///./halt.db (no Docker) or postgresql+psycopg://user:password@host:5432/db
HALT_DB_URL=sqlite+pysqlite:///./halt.db
# Optional, PostgreSQL only: an owner connection for creating the schema, and the role the API then runs as,
# which may only read and append to the audit log and journal. See docker-compose.yml.
# HALT_DB_MIGRATE_URL=postgresql+psycopg://halt:halt@localhost:5432/halt
# HALT_DB_APP_ROLE=halt_app
# Informational: the simulation seed comes from the scenario fixture (incident.json), not from here.
HALT_SEED=2417
HALT_SIGNING_KEY_PATH=./secrets/demo-signing-key.pem
HALT_LLM_ENABLED=false
# A JSON list.
HALT_CORS_ORIGINS=["http://localhost:3000"]
HALT_LOG_LEVEL=INFO

# --- Web (apps/web) ---
# Origins only: the typed client adds /api/v1/..., the socket adds /ws/incidents/{id}
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_WS_ORIGIN=ws://localhost:8000
NEXT_PUBLIC_DEMO_MODE=simulated
